# Copiar a .env y completar. El .env nunca se sube al repositorio.

# PostgreSQL
POSTGRES_DB=expojuy
POSTGRES_USER=expojuy_app
POSTGRES_PASSWORD=G7Fw6Q2JDATv9N8sk0fmMxgia4XjRBIE
POSTGRES_PORT=5433

# PostgreSQL Replicación Streaming (compose.db-replica.yaml)
POSTGRES_REPLICA_PORT=5434
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=ejemplo_password_replicacion_secreta
DB_REPLICA_HOST=postgres-replica
DB_REPLICA_PORT=5432

# PostgreSQL Clúster HA 3 Nodos + HAProxy + Sentinel (compose.cluster-ha.yaml)
# NOTA: POSTGRES_REPLICA_PORT (réplica histórica) y POSTGRES_REPLICA_1_PORT
# comparten el puerto host 5434 por defecto: no levantar compose.db-replica.yaml
# y compose.cluster-ha.yaml a la vez.
POSTGRES_REPLICA_1_PORT=5434
POSTGRES_REPLICA_2_PORT=5435
HA_SENTINEL_PORT=8008
HA_PROXY_WRITE_PORT=5437
HA_PROXY_READ_PORT=5438
HA_PROXY_STATS_PORT=8404
# Credenciales del dashboard de HAProxy (http://127.0.0.1:8404/stats),
# expandidas por HAProxy desde haproxy.cfg al iniciar el contenedor
HA_PROXY_STATS_USER=admin
HA_PROXY_STATS_PASSWORD=ejemplo_password_stats

# pgAdmin (http://localhost:5050)
PGADMIN_EMAIL=admin@expojuy.com
PGADMIN_PASSWORD=yZ1gtzWdSbnQBXo0af9jU5HlR4pm78qL

# Backups (formato cron o @daily, @hourly)
BACKUP_SCHEDULE=@daily

# Backend
# Mínimo 32 caracteres. Generar con: openssl rand -hex 32
JWT_SECRET=cambiar-por-una-clave-aleatoria-de-64-caracteres
# Administrador inicial: se crea solo si la tabla de usuarios está vacía
ADMIN_INITIAL_EMAIL=admin@expojuy.com
ADMIN_INITIAL_PASSWORD=df07fe05f028f26c1ba1ca06d422fff6
# Correo SMTP (opcional: sin esto no se envían recordatorios)
EMAIL_USER=
EMAIL_PASS=

# Frontend (http://localhost:8080)
FRONTEND_PORT=8080
# URL pública del sitio (enlaces en correos y CORS). Cambiar al publicar con el túnel.
PUBLIC_URL=http://localhost:8080

# Herramientas de Gestión (MantisBT y Nextcloud)
TOOLS_DB_ROOT_PASSWORD=cambiar_root_tools_password
MANTIS_PORT=8082
MANTIS_DB_PASSWORD=cambiar_mantis_password
# Token de la API de Mantis para n8n: se genera en Mantis (My Account > API Tokens)
MANTIS_API_TOKEN=token_generado_en_mantis
# Clave de la cuenta "administrator" de Mantis. No la lee ningún contenedor: se escribe a mano
# en Mantis (My Account) después del instalador, en reemplazo de la clave de fábrica "root".
MANTIS_ADMIN_PASSWORD=cambiar_mantis_admin_password
NEXTCLOUD_PORT=8083
NEXTCLOUD_DB_PASSWORD=cambiar_nextcloud_db_password
NEXTCLOUD_ADMIN_USER=admin_expojuy
NEXTCLOUD_ADMIN_PASSWORD=cambiar_admin_nextcloud_password

# Herramientas de Monitoreo (Grafana y Prometheus)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=cambiar_password_grafana
GF_USERS_ALLOW_SIGN_UP=false

# n8n Automatización & Asistente RAG (http://localhost:5679)
N8N_PORT=5679
# Obligatoria. Generar una propia, por ejemplo: openssl rand -hex 32
N8N_ENCRYPTION_KEY=ejemplo_clave_cifrado_n8n_32_caracteres
# URLs con las que n8n arma sus enlaces. Al publicar (docs/PUBLICAR_HERRAMIENTAS.md):
#   N8N_EDITOR_BASE_URL=https://<maquina>.<tailnet>.ts.net:5679/   (Serve, solo tailnet)
#   N8N_WEBHOOK_URL=https://<maquina>.<tailnet>.ts.net:8443/       (Funnel, solo /webhook)
N8N_EDITOR_BASE_URL=http://localhost:5679/
N8N_WEBHOOK_URL=http://localhost:5679/
# Cuenta Owner (administradora) de n8n. No la lee ningún contenedor: se crea a mano en el primer
# acceso al editor (antes de compartirlo) y se guarda acá como referencia.
N8N_OWNER_EMAIL=admin@expojuy.com
N8N_OWNER_PASSWORD=cambiar_password_owner_n8n
# Credenciales externas utilizadas por los agentes y workflows de n8n:
# TELEGRAM_BOT_TOKEN=token_generado_con_botfather
# TELEGRAM_CHAT_ID=id_del_chat_o_grupo_para_alertas
# GOOGLE_GEMINI_API_KEY=clave_api_de_google_ai_studio
# GROQ_API_KEY=clave_api_opcional_de_groq
