# Backend
# Mínimo 32 caracteres. Generar con: openssl rand -hex 32
JWT_SECRET=cambiar-por-una-clave-aleatoria-de-64-caracteres
# Administrador inicial: se crea solo si la tabla de usuarios está vacía
ADMIN_INITIAL_EMAIL=admin@expojuy.com
ADMIN_INITIAL_PASSWORD=df07fe05f028f26c1ba1ca06d422fff6
# Correo SMTP (opcional: sin esto no se envían recordatorios)
EMAIL_USER=
EMAIL_PASS=

# Frontend (http://localhost:8080)
FRONTEND_PORT=8080
# URL pública del sitio (enlaces en correos y CORS). Cambiar al publicar con el túnel.
PUBLIC_URL=http://localhost:8080
