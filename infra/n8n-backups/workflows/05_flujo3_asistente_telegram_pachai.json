      "parameters": {
        "jsCode": "// Extraer datos unificados del mensaje de Telegram (Texto o Audio/Voz)\nconst msg = $input.first().json.message || {};\nconst chatId = (msg.chat?.id || '').toString();\nconst senderName = msg.from?.first_name || 'Visitante';\nconst username = msg.from?.username || '';\nconst rawText = msg.text || msg.caption || '';\nconst isVoice = !!(msg.voice || msg.audio);\nconst fileId = msg.voice?.file_id || msg.audio?.file_id || null;\nconst messageId = (msg.message_id || Date.now()).toString();\nconst timestamp = msg.date ? new Date(msg.date * 1000).toISOString() : new Date().toISOString();\n\nconst messageObj = {\n  message_id: messageId,\n  content: rawText,\n  content_type: isVoice ? 'audio' : 'text',\n  file_id: fileId,\n  timestamp: timestamp\n};\n\nreturn [{\n  json: {\n    chatId,\n    contact_id: chatId,\n    senderName,\n    username,\n    rawText,\n    isVoice,\n    fileId,\n    message: messageObj,\n    timestamp\n  }\n}];"
      },
