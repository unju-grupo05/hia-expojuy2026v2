    "/login": {
      "post": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Iniciar sesión",
        "description": "Autentica a un usuario usando su correo o legajo, y su contraseña.",
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Credenciales del usuario.",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "identificador": {
                  "type": "string",
                  "example": "juan@example.com"
                },
                "password": {
                  "type": "string",
                  "example": "password123"
                }
              }
            }
          }
        ],
        "responses": {
