# =============================================================================
# Configuración del Servidor
# =============================================================================
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200
# Origen publico del frontend, usado en los enlaces de los correos (agenda y B2B).
FRONTEND_URL=http://localhost:4200
TRUST_PROXY=loopback

# =============================================================================
# Base de Datos PostgreSQL
# =============================================================================
DB_NAME=expoJuy
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres
DB_SYNC_ALTER=false

# =============================================================================
# Autenticación JWT
# =============================================================================
JWT_SECRET=tu_clave_secreta_jwt_larga_y_segura_aqui

# =============================================================================
# Credenciales del Administrador Inicial (usadas sólo por el seed)
# =============================================================================
ADMIN_INITIAL_EMAIL=admin@expojuy.com.ar
ADMIN_INITIAL_PASSWORD=TuPasswordSeguro2026!
ADMIN_INITIAL_LEGAJO=ADM-001
ADMIN_INITIAL_DNI=00000000
ADMIN_INITIAL_NOMBRE=Administrador
ADMIN_INITIAL_APELLIDO=del Sistema

# =============================================================================
# Rate Limiting (endpoints públicos sensibles)
# =============================================================================
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_PUBLIC_POST_MAX=5

# =============================================================================
# Correo SMTP (recordatorios de agenda y solicitudes B2B)
# =============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_contrasena_de_aplicacion
APP_TIMEZONE=America/Argentina/Jujuy
